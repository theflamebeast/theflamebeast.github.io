---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="footer-horizon" aria-hidden="true"></div>
  <div class="footer-inner wrap">
    <div class="footer-cta">
      <p class="meta footer-label">Contact</p>
      <a class="footer-email" href={SITE.links.email} data-copy-email={SITE.email}>{SITE.email}</a>
      <div class="footer-actions">
        <a class="meta footer-mail" href={SITE.links.email}>Open in your mail app</a>
        <p class="meta footer-status" data-copy-status role="status" aria-live="polite"></p>
      </div>
    </div>

    <div class="footer-bottom">
      <dl class="footer-meta">
        <div>
          <dt class="meta">Local time</dt>
          <dd><span data-clock>Eastern Time</span></dd>
        </div>
        <div>
          <dt class="meta">Based in</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>
      <ul class="footer-links">
        <li><a href={SITE.links.github}>GitHub</a></li>
        <li><a href={SITE.links.linkedin}>LinkedIn</a></li>
      </ul>
      <p class="meta">&copy; {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--surface);
  }

  /* A thin line of the live ink colour, with a soft glow of the same colour above it. */
  .footer-horizon {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--ink-live);
    pointer-events: none;
  }

  .footer-horizon::before {
    content: '';
    position: absolute;
    inset: auto 0 100%;
    height: clamp(3rem, 8vw, 6rem);
    background: linear-gradient(to top, color-mix(in srgb, var(--ink-live) 26%, transparent), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }

  .footer-inner {
    position: relative;
    padding-top: calc(var(--section) + 2rem);
    padding-bottom: 2rem;
  }

  .footer-cta {
    display: grid;
    gap: 1.25rem;
    padding-bottom: var(--section);
  }

  .footer-email {
    justify-self: start;
    max-width: 100%;
    font-size: clamp(1.25rem, 6.3vw, 6.25rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text);
    background: linear-gradient(
      90deg,
      var(--text) 0 33.3%,
      var(--ink-live) 44%,
      var(--ink-live) 56%,
      var(--text) 66.6% 100%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration-color: var(--text);
  }

  /* One pass of ink colour through the letters; leaving the link snaps it back to rest. */
  .footer-email:hover,
  .footer-email:focus-visible {
    animation: email-sweep 0.9s var(--ease-out) both;
  }

  @keyframes email-sweep {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-email:hover,
    .footer-email:focus-visible {
      animation: none;
      text-decoration: underline;
      text-underline-offset: 0.12em;
    }
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .footer-status {
    color: var(--text);
  }

  .footer-mail:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .footer-meta {
    display: flex;
    gap: 2.5rem;
  }

  .footer-meta dd {
    margin-top: 0.2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }
</style>
