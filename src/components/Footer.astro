---
import { SITE } from '../data/site';
import Link from './Link.astro';

const year = new Date().getFullYear();

// Outline icons after Lucide (ISC licence), drawn inline so no icon font or host is involved.
const MAIL = '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>';
const LINKEDIN =
  '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>';
const GITHUB =
  '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>';
const OUT = '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>';
const COPY = '<rect x="8" y="8" width="14" height="14" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>';

const tiles = [
  // The Email tile copies the address on click (copy.ts); without JS it is a plain mailto link.
  { label: 'Email', value: SITE.email, href: SITE.links.email, icon: MAIL, copy: SITE.email },
  { label: 'LinkedIn', value: 'anishgupta25', href: SITE.links.linkedin, icon: LINKEDIN, copy: undefined },
  // The handle stays inside URLs only (see Conventions), so GitHub's tile says what is there.
  { label: 'GitHub', value: 'Code and projects', href: SITE.links.github, icon: GITHUB, copy: undefined },
];
---

<footer class="footer" id="contact">
  <div class="footer-horizon" aria-hidden="true"></div>
  <div class="footer-inner wrap">
    <div class="footer-cta">
      <h2 class="footer-title">Contact</h2>
      <p class="footer-invite" data-contact-invite>
        Looking for internships, and always up for a conversation about netcode, game servers or
        whatever you are building.
      </p>
      <ul class="tiles">
        {
          tiles.map((t) => (
            <li>
              <Link class="tile" href={t.href} data-contact-tile data-copy-email={t.copy}>
                <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={t.icon} />
                </svg>
                <span class="tile-text">
                  <span class="tile-label meta">{t.label}</span>
                  <span class="tile-value">{t.value}</span>
                </span>
                <svg class="tile-action" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={t.copy ? COPY : OUT} />
                </svg>
              </Link>
            </li>
          ))
        }
      </ul>
      <p class="meta footer-status" data-copy-status role="status" aria-live="polite"></p>
    </div>

    <div class="footer-bottom">
      <dl class="footer-meta">
        <div>
          <dt class="meta">Local time</dt>
          <dd><span data-clock>Eastern Time</span></dd>
        </div>
        <div>
          <dt class="meta">Based in</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>
      <p class="meta">&copy; {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--surface);
  }

  /* A thin line of the live ink colour, with a soft glow of the same colour above it. */
  .footer-horizon {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--ink-live);
    pointer-events: none;
  }

  .footer-horizon::before {
    content: '';
    position: absolute;
    inset: auto 0 100%;
    height: clamp(3rem, 8vw, 6rem);
    background: linear-gradient(to top, color-mix(in srgb, var(--ink-live) 26%, transparent), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }

  .footer-inner {
    position: relative;
    padding-top: calc(var(--section) + 2rem);
    padding-bottom: 2rem;
  }

  .footer-cta {
    display: grid;
    gap: 1.25rem;
    padding-bottom: var(--section);
  }

  .footer-title {
    justify-self: start;
    max-width: 100%;
    margin: 0;
    font-size: clamp(3.5rem, 11vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
    color: var(--text);
    background: linear-gradient(
      90deg,
      var(--text) 0 33.3%,
      var(--ink-live) 44%,
      var(--ink-live) 56%,
      var(--text) 66.6% 100%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* One pass of ink colour through the letters on hover; leaving snaps it back to rest. */
  .footer-title:hover {
    animation: title-sweep 0.9s var(--ease-out) both;
  }

  @keyframes title-sweep {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-title:hover {
      animation: none;
    }
  }

  .footer-status {
    min-height: 1lh;
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .footer-meta {
    display: flex;
    gap: 2.5rem;
  }

  .footer-meta dd {
    margin-top: 0.2rem;
  }

  .footer-invite {
    max-width: var(--measure);
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
  }

  .tile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: color-mix(in srgb, var(--ink-live) 55%, transparent);
    background: color-mix(in srgb, var(--ink-live) 6%, var(--bg));
  }

  .tile-icon,
  .tile-action {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tile-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
  }

  .tile-action {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
    transition:
      color 0.25s,
      translate 0.25s var(--ease-out);
  }

  .tile:hover .tile-icon,
  .tile:hover .tile-action,
  .tile:focus-visible .tile-action {
    color: var(--ink-live);
  }

  .tile:hover .tile-action {
    translate: 2px -2px;
  }

  .tile-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .tile-label {
    text-transform: uppercase;
    font-size: 0.6875rem;
  }

  .tile-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile-action {
      transition: none;
    }

    .tile:hover .tile-action {
      translate: none;
    }
  }
</style>
