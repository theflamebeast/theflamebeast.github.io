---
// A diagonal arrow that turns as its section scrolls past (src/motion/scrub.ts, wide screens only).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" data-rotate>
  <path d="M5 5 L19 19 M19 8 V19 H8" stroke-linecap="square"></path>
</svg>
