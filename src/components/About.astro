---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import { CERTS, EDUCATION, SKILLS, SITE } from '../data/site';
import Link from './Link.astro';

const skillGroups: [string, string[]][] = [
  ['Languages', SKILLS.languages],
  ['Frameworks', SKILLS.frameworks],
  ['Tools', SKILLS.tools],
];
---

<section class="about wrap" id="about" aria-labelledby="about-title">
  <div class="about-side">
    <h2 class="section-title" id="about-title" data-reveal="lines">About</h2>
    <figure class="portrait" data-portrait data-reveal="fade">
      <Picture
        src={portrait}
        alt={`A pencil-style portrait of ${SITE.name}, in glasses and a hoodie`}
        formats={['avif', 'webp']}
        widths={[320, 640, 960]}
        sizes="(min-width: 861px) 20rem, 16rem"
        loading="lazy"
      />
    </figure>
  </div>
  <div class="about-body">
    <p class="about-lede" data-reveal="lines">
      I'm studying computer science at the {EDUCATION.school}, graduating in {EDUCATION.expected}. I like owning the
      whole thing: the simulation, the netcode, the servers, the deploy pipeline, and the page you're reading.
    </p>

    <dl class="skills" data-reveal="fade">
      {
        skillGroups.map(([label, items]) => (
          <div>
            <dt class="meta">{label}</dt>
            <dd>{items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>

    <div data-reveal="fade">
      <h3 class="meta certs-title">Certifications</h3>
      <ul class="certs" data-certs>
        {
          CERTS.map((c) => (
            <li>
              <span class="cert-name">{c.url ? <Link href={c.url}>{c.name}</Link> : c.name}</span>
              <span class="meta">
                {c.issuer}, {c.year}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(1.5rem, 4vw, 4rem);
    padding-block: var(--section);
  }

  .about-side {
    display: grid;
    align-content: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .portrait {
    width: min(100%, 20rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-body {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-width: 44rem;
  }

  .about-lede {
    font-size: var(--step-2);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .skills {
    display: grid;
    gap: 1.1rem;
  }

  .skills dd {
    margin-top: 0.2rem;
    color: var(--text-soft);
  }

  .certs-title {
    margin-bottom: 0.75rem;
  }

  .certs li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: min(100%, 16rem);
    }
  }
</style>
