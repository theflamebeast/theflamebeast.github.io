---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

<section class="gallery wrap" aria-label="Screenshots">
  {
    images.map((img) => (
      <figure class="shot" data-reveal="fade">
        <Picture
          src={img.src}
          alt={img.alt}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 960px) 44vw, 100vw"
          loading="lazy"
        />
      </figure>
    ))
  }
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: var(--section);
  }

  .shot {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    aspect-ratio: 16 / 9;
  }

  /* An odd count would leave one tile alone on the last row; let the first span both columns. */
  .shot:first-child:nth-last-child(2n + 1) {
    grid-column: 1 / -1;
    aspect-ratio: 21 / 9;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .shot:first-child:nth-last-child(2n + 1) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
