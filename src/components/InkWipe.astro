---
import { getImage } from 'astro:assets';
import inkStill from '../assets/ink-still.webp';

const still = await getImage({ src: inkStill, width: 1280, format: 'webp' });
---

<div
  class="wipe"
  data-ink-wipe
  data-state="idle"
  aria-hidden="true"
  transition:persist="ink-wipe"
  style={`--wipe-still: url(${still.src})`}
>
  <p class="wipe-label" data-wipe-label></p>
</div>

<style>
  .wipe {
    --wipe-x: 50vw;
    --wipe-y: 50vh;
    --wipe-r: 0px;
    --wipe-feather: 14vmax;

    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    pointer-events: none;
    visibility: hidden;
    background: var(--wipe-still) center / cover no-repeat, var(--bg);
  }

  .wipe[data-state='covering'],
  .wipe[data-state='covered'] {
    visibility: visible;
    -webkit-mask-image: radial-gradient(
      circle at var(--wipe-x) var(--wipe-y),
      #000 calc(var(--wipe-r) - var(--wipe-feather)),
      transparent var(--wipe-r)
    );
    mask-image: radial-gradient(
      circle at var(--wipe-x) var(--wipe-y),
      #000 calc(var(--wipe-r) - var(--wipe-feather)),
      transparent var(--wipe-r)
    );
  }

  .wipe[data-state='opening'] {
    visibility: visible;
    -webkit-mask-image: radial-gradient(
      circle at var(--wipe-x) var(--wipe-y),
      transparent calc(var(--wipe-r) - var(--wipe-feather)),
      #000 var(--wipe-r)
    );
    mask-image: radial-gradient(
      circle at var(--wipe-x) var(--wipe-y),
      transparent calc(var(--wipe-r) - var(--wipe-feather)),
      #000 var(--wipe-r)
    );
  }

  /* The preloader. Only this animation lifts the cover when the page's scripts never run; once
     they do, the state leaves idle and this rule stops applying. */
  :global(html[data-intro]) .wipe[data-state='idle'] {
    visibility: visible;
    animation: intro-failsafe 0.3s 2.2s forwards;
  }

  /* The cover is the transition. The browser's crossfade would blend a snapshot of the new page
     through the full-screen ink mid-swap, and under reduced motion the swap is instant anyway.
     skipTransition() would do the same but leaves the router's promises rejecting unhandled. */
  :global(::view-transition-group(*)),
  :global(::view-transition-old(*)),
  :global(::view-transition-new(*)) {
    animation: none !important;
  }

  @keyframes intro-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .wipe-label {
    margin: 0;
    padding-inline: var(--gutter);
    font-size: var(--step-hero);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.92;
    text-align: center;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .wipe[data-state='covered'] .wipe-label {
    opacity: 1;
  }
</style>
