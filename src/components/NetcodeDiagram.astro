<figure class="diagram wrap" data-reveal="fade">
  <div class="diagram-scroll">
    <svg viewBox="0 0 760 360" role="img" aria-labelledby="netcode-title netcode-desc">
      <title id="netcode-title">How Stashout keeps the client and server in step</title>
      <desc id="netcode-desc">
        The client turns input into a local prediction on the shared simulation and sends its inputs to the
        server. The server ticks the authoritative game and sends snapshots back. The client reconciles each
        snapshot by rewinding to it and replaying the inputs the server has not seen yet, then keeps predicting.
      </desc>
      <defs>
        <marker id="nc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" fill="currentColor"></path>
        </marker>
      </defs>

      <g class="lane-label">
        <text x="160" y="24">Client</text>
        <text x="600" y="24">Server</text>
      </g>
      <line class="divider" x1="380" y1="40" x2="380" y2="340"></line>

      <g class="node"><rect x="40" y="48" width="240" height="56" rx="12"></rect><text x="160" y="81">Your input</text></g>
      <g class="node accent"><rect x="40" y="152" width="240" height="56" rx="12"></rect><text x="160" y="185">Client prediction</text></g>
      <g class="node"><rect x="40" y="256" width="240" height="56" rx="12"></rect><text x="160" y="289">Reconciliation</text></g>
      <g class="node accent"><rect x="480" y="100" width="240" height="56" rx="12"></rect><text x="600" y="133">Server tick</text></g>
      <g class="node"><rect x="480" y="204" width="240" height="56" rx="12"></rect><text x="600" y="237">Snapshot</text></g>

      <g class="edge">
        <path d="M160 104 V148" marker-end="url(#nc-arrow)"></path>
        <path d="M280 172 C380 172 380 128 476 128" marker-end="url(#nc-arrow)"></path>
        <path d="M600 156 V200" marker-end="url(#nc-arrow)"></path>
        <path d="M480 232 C380 232 380 284 284 284" marker-end="url(#nc-arrow)"></path>
        <path d="M60 256 C20 236 20 208 36 196" marker-end="url(#nc-arrow)"></path>
      </g>
      <g class="edge-label">
        <text x="380" y="126">inputs</text>
        <text x="380" y="284">snapshots</text>
        <text x="28" y="236" text-anchor="end" class="small">replay</text>
      </g>
    </svg>
  </div>
  <figcaption class="meta">The client never waits for the server: it predicts, then corrects.</figcaption>
</figure>

