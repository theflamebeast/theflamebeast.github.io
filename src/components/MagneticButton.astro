---
interface Props {
  href: string;
  label: string;
  strength?: number;
  strengthText?: number;
}

const { href, label, strength = 40, strengthText = 20 } = Astro.props;
---

<a class="mbtn" href={href} data-magnetic data-strength={strength} data-strength-text={strengthText}>
  <span class="mbtn-fill" aria-hidden="true"></span>
  <span class="mbtn-text">{label}</span>
</a>

<style>
  .mbtn {
    position: relative;
    display: inline-grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: 1.1rem 2rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    background: var(--surface);
    transition: border-color 0.3s;
  }

  .mbtn-fill {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: var(--text);
    translate: 0 101%;
    transition: translate 0.5s var(--ease-out);
  }

  .mbtn-text {
    position: relative;
    display: inline-block;
  }

  .mbtn:hover .mbtn-text {
    color: var(--bg);
  }

  .mbtn:hover .mbtn-fill {
    translate: 0 0;
  }

  .mbtn-text {
    transition: color 0.3s;
  }
</style>
