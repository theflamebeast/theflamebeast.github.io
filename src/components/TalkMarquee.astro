---
const repeats = Array.from({ length: 4 });
---

<a class="talk" href="#contact" aria-label="Let's talk">
  <span class="talk-track" data-marquee aria-hidden="true">
    {
      repeats.map(() => (
        <span class="talk-item">
          Let's talk
          <span class="talk-dot" />
        </span>
      ))
    }
  </span>
</a>

<style>
  .talk {
    display: block;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 5rem);
    text-decoration: none;
    border-top: 1px solid var(--line);
  }

  .talk-track {
    display: flex;
    width: max-content;
  }

  .talk-item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
    font-size: clamp(4rem, 2rem + 11vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    white-space: nowrap;
  }

  .talk-dot {
    width: 0.16em;
    height: 0.16em;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
