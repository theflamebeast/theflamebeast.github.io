---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Nav from '../components/Nav.astro';
import MenuPanel from '../components/MenuPanel.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;
const featured = (await getCollection('projects')).filter((p) => p.data.tier === 'featured');
const routeTitles: Record<string, string> = {
  '/': 'Home',
  ...Object.fromEntries(featured.map((p) => [`/work/${p.id}`, p.data.title])),
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#06070c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <MenuPanel />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script type="application/json" id="route-titles" set:html={JSON.stringify(routeTitles)} />
  </body>
</html>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initClock } from '../motion/clock';
  import { onPage } from '../motion/lifecycle';
  import { initReveals } from '../motion/reveal';
  import { initSmoothScroll } from '../motion/scroll';
  import { initScrub } from '../motion/scrub';
  import { initCaseVideo } from '../motion/video';

  onPage(() => {
    const cleanups = [initSmoothScroll(), initReveals(), initScrub(), initClock(), initCaseVideo()];
    ScrollTrigger.refresh();
    return () => {
      for (const cleanup of cleanups.reverse()) cleanup();
    };
  });
</script>
