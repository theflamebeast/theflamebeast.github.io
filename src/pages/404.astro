---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title={`Page not found, ${SITE.name}`} description="This page doesn't exist." noindex>
  <section class="missing wrap">
    <p class="meta">404</p>
    <h1 class="missing-title">This page doesn't exist.</h1>
    <p class="missing-text">The link may be old, or the address mistyped.</p>
    <a class="missing-home" href="/">Go to the home page</a>
  </section>
</Base>

<style>
  .missing {
    min-height: 80vh;
    padding-top: clamp(9rem, 20vw, 14rem);
    padding-bottom: var(--section);
  }

  .missing-title {
    margin-block: 1rem 1.25rem;
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .missing-text {
    color: var(--text-soft);
  }

  .missing-home {
    display: inline-block;
    margin-top: 2rem;
  }
</style>
