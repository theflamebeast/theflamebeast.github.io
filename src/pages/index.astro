---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CompactCard from '../components/CompactCard.astro';
import ScreenshotRows from '../components/ScreenshotRows.astro';
import About from '../components/About.astro';
import { SITE } from '../data/site';
import { getModrinthDownloads } from '../lib/modrinth';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.tier === 'featured');
const compact = projects.filter((p) => p.data.tier === 'compact');

const downloads = Object.fromEntries(
  await Promise.all(
    compact.map(async (p) => [
      p.id,
      p.data.modrinthSlug ? (await getModrinthDownloads(p.data.modrinthSlug)).downloads : 0,
    ]),
  ),
);

const rowImages: ImageMetadata[] = featured.flatMap((p) => [
  ...(p.data.cover ? [p.data.cover] : []),
  ...p.data.gallery.map((g) => g.src),
]);
---

<Base title={`${SITE.name}, ${SITE.role.toLowerCase()}`} description={`${SITE.name}: ${SITE.tagline}`}>
  <Hero />

  <section class="work wrap" id="work" aria-labelledby="work-title">
    <h2 class="section-title work-title" id="work-title" data-reveal="lines">Selected work</h2>
    {featured.map((p) => <ProjectCard project={p} />)}
    {compact.map((p) => <CompactCard project={p} downloads={downloads[p.id]} />)}
  </section>

  <ScreenshotRows images={rowImages} />

  <About />
</Base>

<style>
  .work {
    padding-top: var(--section);
  }

  .work-title {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
</style>
