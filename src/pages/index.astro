---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CompactCard from '../components/CompactCard.astro';
import ScreenshotRows from '../components/ScreenshotRows.astro';
import About from '../components/About.astro';
import { SITE } from '../data/site';
import { loadProjects } from '../lib/projects';

const { featured, compact, downloads } = await loadProjects();

const rowImages: ImageMetadata[] = featured.flatMap((p) => [
  ...(p.data.cover ? [p.data.cover.src] : []),
  ...p.data.gallery.map((g) => g.src),
]);
---

<Base title={`${SITE.name}, ${SITE.role.toLowerCase()}`} description={`${SITE.name}: ${SITE.tagline}`}>
  <Hero />

  <section class="work wrap" id="work" aria-labelledby="work-title">
    <h2 class="section-title work-title" id="work-title" data-reveal="lines">Selected work</h2>
    {featured.map((p) => <ProjectCard project={p} />)}
    {compact.map((p) => <CompactCard project={p} downloads={downloads[p.id] ?? 0} />)}
  </section>

  <ScreenshotRows images={rowImages} />

  <About />
</Base>

<style>
  .work {
    padding-top: var(--section);
  }

  .work-title {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
</style>
